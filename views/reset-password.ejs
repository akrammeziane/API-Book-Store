<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body>
    <div
      class="flex flex-col justify-center items-center w-screen h-screen bg-cyan-300"
    >
      <form
        class="flex flex-col bg-cyan-50 border-0 justify-center rounded-lg shadow-md w-[400px] h-[400px]"
        method="post"
        action=""
      >
        <h1 class="font-bold text-3xl text-amber-500 text-center">
          Reset Password <%= email %>
        </h1>
        <label class="text-left" for="password">Password:</label>
        <input
          class="border rounded-2xl w-full"
          type="password"
          id="password"
          name="password"
        />
        <input
          type="submit"
          class="bg-green-500 rounded-lg p-2 shadow-md mt-2"
          value="submit"
        />
      </form>
    </div>
  </body>
</html>
