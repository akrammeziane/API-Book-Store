const userschema = new mongoose.Schema(
  {
    Email: {
      type: String,
      minlength: 5,
      maxlength: 200,
      required: true,
      trim: true,
      unique: true,
    },
    UserName: {
      type: String,
      minlength: 3,
      maxlength: 100,
      required: true,
      trim: true,
    },
    Password: {
      type: String,
      // minlength: 4,
      // maxlength: 1000,
      trim: true,
      required: true,
    },
    isAdmin: {
      type: Boolean,
      default: false,
    },
  },
  { timestamps: true },
);
userschema.methods.genTokens = function () {
  return jwt.sign(
    { id: this._id, UserName: this.UserName, isAdmin: this.isAdmin },
    `${process.env.JWT_TOKEN}`,
    { expiresIn: "7d" },
  );
};
